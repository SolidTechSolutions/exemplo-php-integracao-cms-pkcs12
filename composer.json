{
    "name": "solidtech/exemplo-php-integracao-cms-pkcs12",
    "description": "SolidSign CAdES (CMS) signing example — PKCS#12 pre-imported certificate",
    "type": "project",
    "require": {
        "php": "^8.1",
        "slim/slim": "^4.12",
        "slim/psr7": "^1.6",
        "guzzlehttp/guzzle": "^7.8",
        "vlucas/phpdotenv": "^5.6"
    },
    "autoload": {
        "psr-4": {
            "SolidSign\\": "src/"
        }
    },
    "config": {
        "optimize-autoloader": true
    }
}
